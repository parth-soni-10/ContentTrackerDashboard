# Files in this repo that are NOT part of the published site.
#
# The assets directory is the repository root (same as Netlify's publish
# directory), so everything not listed here would be served. Cloudflare parses
# `_headers` even though it is listed below — verified against the deployed
# Dashboard Portal, which applies its CSP while serving no `/_headers` — so the
# header policy stays in effect without the file itself being readable.
.git/
.github/
.gitignore
.freebuff/
.wrangler/
.netlify/
node_modules/

netlify/
migrations/
tools/
brag-output/

# Local secrets for `wrangler dev` — the same file .gitignore refuses.
.dev.vars

README.md
CLAUDE.md
LICENSE
_headers
package.json
package-lock.json
wrangler.toml
wrangler.dev.toml
worker.js
.assetsignore
# Deploy files. This repository's Pages mirror control config, the scripts that
# deploy it, and the staging output those scripts write (`.pages-bundle/`,
# `.pages-dist/`) are development files: the assets directory is the repository
# root, so anything not listed here would be uploaded and served.
pages/
.pages-bundle/
.pages-dist/
