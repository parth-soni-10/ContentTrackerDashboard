/.freebuff
/brag-output/

# The database client and its lockfile are installed by Netlify on every deploy;
# node_modules itself is never part of the repo, and the lockfile is (it pins the
# driver versions the functions run with).
/node_modules

# Local secrets. A key in here is what lets the functions be exercised by hand
# (netlify dev reads .env, as does any local runner), so the file has to exist —
# and it must never be committable, or the first `git add -A` publishes it.
/.env
/.env.local
